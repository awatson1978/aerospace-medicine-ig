     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: CodeSystem radioprotective-medication-cs</b></p><a name=\"radioprotective-medication-cs\"> </a><a name=\"hcradioprotective-medication-cs\"> </a><p>This case-sensitive code system <code>https://mitre.org/fhir/space-health/CodeSystem/radioprotective-medication-cs</code> defines the following codes:</p><table class=\"codes\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr><tr><td style=\"white-space:nowrap\">nac<a name=\"radioprotective-medication-cs-nac\"> </a></td><td>N-Acetylcysteine (NAC)</td><td>Antioxidant and glutathione precursor with radioprotective properties</td></tr><tr><td style=\"white-space:nowrap\">amifostine<a name=\"radioprotective-medication-cs-amifostine\"> </a></td><td>Amifostine</td><td>Cytoprotective agent that scavenges free radicals generated by ionizing radiation</td></tr><tr><td style=\"white-space:nowrap\">vitamin-e-succinate<a name=\"radioprotective-medication-cs-vitamin-e-succinate\"> </a></td><td>Vitamin E Succinate (Tocopherol)</td><td>Fat-soluble antioxidant with radioprotective activity</td></tr><tr><td style=\"white-space:nowrap\">selenium-methionine<a name=\"radioprotective-medication-cs-selenium-methionine\"> </a></td><td>Selenium Methionine</td><td>Trace element essential for antioxidant enzyme function</td></tr><tr><td style=\"white-space:nowrap\">glutathione-precursor<a name=\"radioprotective-medication-cs-glutathione-precursor\"> </a></td><td>Glutathione Precursor</td><td>Supplements that increase intracellular glutathione levels</td></tr></table></div>"^^rdf:XMLLiteral ]
