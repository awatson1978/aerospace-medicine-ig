// Fictional patients used as example subjects throughout the guide.
// Names are borrowed from science fiction; none of these records describe a real person.
// Every instance carries the FictionalExample provenance tags (see SharedExtensions.fsh).


Instance: CaptainJaneway
InstanceOf: Astronaut
Title: "Patient - Catherine Janeway"
Description: "Patient - Catherine Janeway"
Usage: #example
* insert FictionalExample
* id = "janeway"
* name
  * given[0] = "Catherine"
  * family = "Janeway"


